
<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#07132f"/>
      <stop offset="100%" stop-color="#101044"/>
    </linearGradient>
    <linearGradient id="gradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#12d9f5"/>
      <stop offset="50%" stop-color="#4778ff"/>
      <stop offset="100%" stop-color="#a238ff"/>
    </linearGradient>
    <linearGradient id="white" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#c7e7ff"/>
    </linearGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="5" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="512" height="512" rx="48" fill="url(#bg)"/>

  <!-- Outer ring -->
  <circle cx="256" cy="215" r="174"
          fill="none" stroke="url(#gradient)"
          stroke-width="5" filter="url(#glow)"/>

  <!-- Main C symbol -->
  <path d="M319 145
           A82 82 0 1 0 328 273"
        fill="none" stroke="url(#gradient)"
        stroke-width="22" stroke-linecap="round"/>

  <!-- AI lettering -->
  <text x="242" y="232" text-anchor="middle"
        font-family="Arial, Helvetica, sans-serif"
        font-size="66" font-weight="800"
        fill="url(#white)">AI</text>

  <!-- Graduation cap -->
  <path d="M173 104 L255 73 L339 104 L256 136 Z"
        fill="url(#white)" stroke="#ffffff" stroke-width="2"
        stroke-linejoin="round"/>
  <path d="M193 116 V140 Q256 166 319 140 V116"
        fill="none" stroke="url(#white)" stroke-width="8"
        stroke-linecap="round"/>
  <path d="M339 104 V143"
        stroke="#7cecff" stroke-width="4"/>
  <circle cx="339" cy="148" r="5" fill="#7cecff"/>
  <path d="M335 151 L331 168 Q339 174 347 168 L343 151 Z"
        fill="#7cecff"/>

  <!-- Career growth bars -->
  <rect x="290" y="270" width="13" height="24" rx="3"
        fill="#427bff"/>
  <rect x="309" y="253" width="13" height="41" rx="3"
        fill="#5964ff"/>
  <rect x="328" y="235" width="13" height="59" rx="3"
        fill="#8450ff"/>

  <!-- Upward arrow -->
  <path d="M281 276 Q315 251 337 215"
        fill="none" stroke="url(#gradient)"
        stroke-width="12" stroke-linecap="round"/>
  <path d="M318 217 L344 202 L346 232 Z"
        fill="#19d8f5"/>

  <!-- Brand name -->
  <text x="256" y="356" text-anchor="middle"
        font-family="Arial, Helvetica, sans-serif"
        font-size="43" font-weight="800"
        fill="#ffffff">Career <tspan fill="url(#gradient)">AI</tspan></text>

  <!-- Tagline -->
  <text x="256" y="386" text-anchor="middle"
        font-family="Arial, Helvetica, sans-serif"
        font-size="14" letter-spacing="2.2"
        fill="#b8d9ff">YOUR CAREER • OUR AI</text>

  <!-- Bottom accent -->
  <rect x="203" y="405" width="106" height="3" rx="2"
        fill="url(#gradient)"/>
</svg>
